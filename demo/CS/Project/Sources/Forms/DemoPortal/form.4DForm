{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onPageChange",
		"onValidate",
		"onClick",
		"onDoubleClick",
		"onOutsideCall",
		"onBeginDragOver",
		"onDragOver",
		"onDrop",
		"onAfterKeystroke",
		"onMenuSelect",
		"onPluginArea",
		"onAfterEdit",
		"onTimer",
		"onBoundVariableChange"
	],
	"windowTitle": "window title",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"Text": {
					"type": "text",
					"text": "Demo Structure for Client Server Database",
					"top": 20,
					"left": 20,
					"width": 800,
					"height": 28,
					"class": "Arial_24_B",
					"textAlign": "center"
				},
				"Text1": {
					"type": "text",
					"text": "This Database Structure will act as the Client Server Database for the Technical Note example.\r\rIf a Remote Client connects to the server. A message reports the successful connection.\r\rIf this structure is opened in local mode, this dialog is displayed.\r\rClick the Button below to return to design mode.\rMake sure to confirm the Build XML contains the proper key and path for the embedded database structure. \rIn Design Mode, go to File Menu > Design > Build Application... and build the Client and Server applications when ready.\r\rAfter the build completes, add the 4D Internet Commands Plugin to the built client application. Next, create two copies of the Built Demo_CS 4D Server application. Run one copy and change it's Port in the database settings. Restart it to confirm the IP applies. Run a second copy with the default Port.\r\rCreate a \"1.4dlink\" file with one of the Server's address and port and a \"2.4dlink\" and add it to the built application's Database/Resources/Servers/ directory. There should already be two files provided with ports 19823 and 19813.\r\rRun the built remote client application. It should connect to the Server specified in \"1.4dlink\".\rClose the application and close the Server associated with \"1.4dlink\"\rRun the built remote client application again. It should now connect to the second server specified in \"2.4dlink\"\r",
					"top": 68,
					"left": 20,
					"width": 800,
					"height": 500,
					"class": "Arial_16"
				},
				"Button": {
					"type": "button",
					"text": "Design Mode",
					"top": 588,
					"left": 339,
					"width": 164,
					"height": 38,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/Button.4dm",
					"action": "design",
					"class": "Arial_16_B"
				}
			}
		}
	],
	"geometryStamp": 60,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"method": "method.4dm"
}